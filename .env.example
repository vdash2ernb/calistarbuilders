# Copy to .env.local for local development. Set the same values in the hosting
# provider's environment settings for production.
#
# Without SMTP settings, form submissions are printed to the terminal in
# development and rejected in production (so leads are never silently lost).

# SMTP server used to send form submissions. Zoho Mail (the domain's current
# email provider) uses smtp.zoho.com on port 465 with an app-specific password.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Where quote requests and network applications are delivered.
FORM_TO_EMAIL=info@calistar.builders
# Sender address; defaults to SMTP_USER. Must be allowed to send via SMTP_USER.
FORM_FROM_EMAIL=
